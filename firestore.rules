rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    match /usernames/{normalizedUsername} {
      allow read: if true;
      allow create: if normalizedUsername is string && normalizedUsername.size() >= 1;
      allow update, delete: if true;
    }

    // Workspaces and Shared Lists
    match /lists/{listDocId} {
      allow read: if isValidId(listDocId);
      allow create: if isValidId(listDocId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100;
      allow update: if isValidId(listDocId) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100;
      allow delete: if isValidId(listDocId);
    }

    match /memberships/{membershipId} {
      allow read: if isValidId(membershipId);
      allow create, update: if isValidId(membershipId) &&
        request.resource.data.role in ['owner', 'editor', 'viewer'];
      allow delete: if isValidId(membershipId);
    }

    // Main Planner Tasks
    match /tasks/{taskId} {
      allow read: if isValidId(taskId);
      allow create: if isValidId(taskId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300;
      allow update: if isValidId(taskId) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 300;
      allow delete: if isValidId(taskId);
    }

    // Unorganized Tasks (Talk to Todo-chan)
    match /unorganized_tasks/{taskId} {
      allow read: if isValidId(taskId);
      allow create, update: if isValidId(taskId) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000;
      allow delete: if isValidId(taskId);
    }

    // Private Wellness Check-ins & Daily Reflections
    match /wellness_checkins/{checkinId} {
      allow read, write, delete: if isValidId(checkinId);
    }

    // Care Tasks
    match /care_tasks/{careTaskId} {
      allow read, write, delete: if isValidId(careTaskId);
    }

    // Task Comments
    match /comments/{commentId} {
      allow read: if isValidId(commentId);
      allow create: if isValidId(commentId) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 2000;
      allow update, delete: if isValidId(commentId);
    }

    // Real-time Chat Messages per List
    match /messages/{messageId} {
      allow read: if isValidId(messageId);
      allow create: if isValidId(messageId) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 2000;
      allow update, delete: if false;
    }
  }
}
